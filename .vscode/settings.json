{
  // ----- LaTeX Workshop: compile and view PDF -----
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.rootFile": "Oxford_Thesis.tex",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex ➞ bibtex ➞ pdflatex × 2",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    },
    {
      "name": "latexmk (thesis)",
      "tools": ["latexmk"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%DOCFILE%"],
      "env": {}
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,

  // The 'mathematic.vscode-latex' extension runs chktex on every edit, and
  // TeX Live 2024's global chktexrc has one rule (line 247) written with PCRE
  // lookaheads but not tagged 'PCRE:'. Our chktex is a POSIX-regex build, so it
  // fails to compile that rule and pops up a warning. LaTeX Workshop already
  // covers building/preview, so its linter is just noise here.
  "latex.linter.enabled": false,

  // ----- Spell checker: English (UK) -----
  "cSpell.language": "en-GB",
  "cSpell.enabled": true,
  "#cSpell.enableFiletypes#": ["latex", "plaintext"],
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode/*",
    ".vscode-insiders",
    "figures/*",
    "FUTURE_MIKE_HEADER.md",
    "INSTALL.txt",
    "LATEX_SETUP.md",
    "LICENSE",
    "ociamthesis.cls",
    "outline.pdf",
    "Oxford_Thesis_submission.pdf",
    "Oxford_Thesis.pdf",
    "Oxford_Thesis.tex",
    "README.md",
    "references.bib",
    "splitcolor.py",
    "tmp.txt",
    "VIVA_NOTES.md"
  ],
